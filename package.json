{
  "name": "autobusiness",
  "version": "0.0.0",
  "private": true,
  "description": "AutoBusiness — Zero Human Company monorepo",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=\"./packages/**\" build",
    "test": "vitest run",
    "test:contracts": "vitest run tests/contracts",
    "test:schemas": "vitest run tests/contracts/schemas.test.ts",
    "demo": "pnpm -r --parallel --if-present demo",
    "clean": "pnpm -r --parallel exec rm -rf dist .next .turbo node_modules && rm -rf node_modules"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild", "sharp"]
  },
  "devDependencies": {
    "@autobiz/shared": "workspace:*",
    "@types/node": "^20.14.10",
    "fastify": "^5.0.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}

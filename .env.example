# =============================================================
# AutoBusiness — environment template
# copy this to `.env` and fill in real values (never commit .env)
# =============================================================
#
# tiers:
#   [REQUIRED]    demo can't run without this
#   [ELEVATES]    demo works without it (falls back to fixtures)
#   [OPTIONAL]    only if the corresponding plugin is enabled in Settings

# =============================================================
# [REQUIRED] TERAC — mandatory sponsor · human panel API
# =============================================================
# get from: https://terac.dev/dashboard → API keys
TERAC_API_KEY=terac_sk_replace_me
TERAC_ORG_ID=org_replace_me
TERAC_PANEL_URL=https://api.terac.dev/v1
# default study params
TERAC_DEFAULT_SAMPLE_SIZE=15
TERAC_DEFAULT_TIMEOUT_SEC=180

# =============================================================
# [REQUIRED] ANTHROPIC — Claude LLM for all thinking agents
# =============================================================
# get from: https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=sk-ant-replace_me
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001

# =============================================================
# [REQUIRED] STRIPE — payments · use RESTRICTED key (rk_) only
# =============================================================
# get from: https://dashboard.stripe.com → Developers → API keys → Restricted
# scopes needed: Balance:read, Charges:read, PaymentLinks:write
STRIPE_RESTRICTED_KEY=rk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=usd

# =============================================================
# [ELEVATES] RENDER — deployment target for generated landings
# =============================================================
# get from: https://dashboard.render.com → Account → API keys
# free tier is fine for the demo
RENDER_API_KEY=rnd_replace_me
RENDER_OWNER_ID=own_replace_me
RENDER_REGION=oregon

# =============================================================
# [ELEVATES] LINQ — iMessage owner alerts (sponsor tool)
# =============================================================
# get from: linq dashboard
LINQ_API_KEY=linq_replace_me
LINQ_OWNER_PHONE=+1XXXXXXXXXX
LINQ_OWNER_NAME=Sreekanth

# =============================================================
# [ELEVATES] SUPERSERVE — sandbox browsers (sponsor tool)
# =============================================================
# used by Researcher (scraping) and as agent isolation layer
SUPERSERVE_API_KEY=ss_replace_me
SUPERSERVE_POOL_SIZE=3
SUPERSERVE_SESSION_TTL_SEC=600

# =============================================================
# [ELEVATES] LOOP QA (qa.replay.io) — AI QA for Replay QA agent
# =============================================================
# get from: https://qa.replay.io → Settings → API keys
# token format: lqa_... (shown once)
REPLAY_API_KEY=lqa_replace_me
REPLAY_BASE_URL=https://qa.replay.io/api/v1

# =============================================================
# [OPTIONAL] SHOPIFY — real product listings alt to landing template
# =============================================================
SHOPIFY_SHOP_DOMAIN=yourshop.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_replace_me
SHOPIFY_STOREFRONT_TOKEN=

# =============================================================
# [OPTIONAL] CLOUDFLARE — custom domains + DNS
# =============================================================
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=

# =============================================================
# [OPTIONAL] TWILIO — SMS fallback to Linq
# =============================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# =============================================================
# [OPTIONAL] SENDGRID — email
# =============================================================
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# =============================================================
# [OPTIONAL] Analytics + research
# =============================================================
GA4_MEASUREMENT_ID=
ETSY_API_KEY=
META_ACCESS_TOKEN=
AMAZON_SELLER_KEY=

# =============================================================
# APP CONFIG
# =============================================================
NODE_ENV=development
LOG_LEVEL=info
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=file:./autobiz.db
NEXTAUTH_SECRET=change_me_to_a_random_string
ENCRYPTION_KEY=change_me_32_bytes_hex   # for encrypting stored plugin keys at rest

# server ports
ORCH_PORT=4000
INTEGRATIONS_PORT=4100
UI_PORT=3000

# =============================================================
# DEMO / FIXTURE FLAGS
# =============================================================
# true = replay canned traces from /fixtures, skip external calls
FIXTURE_MODE=false
# true = settings page shows mock "connected" tiles regardless of real keys
DEMO_SETTINGS_MODE=true
# owner contact shown in the demo (matches the top-right avatar)
DEMO_OWNER_NAME=Sreekanth
DEMO_OWNER_EMAIL=putta.sreekanth1@gmail.com
